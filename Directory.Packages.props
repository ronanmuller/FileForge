<Project>
  <!-- Central Package Management: versÃƒÆ’Ã‚Âµes definidas uma ÃƒÆ’Ã‚Âºnica vez para toda a soluÃƒÆ’Ã‚Â§ÃƒÆ’Ã‚Â£o. -->
  <PropertyGroup>
